# Saccade Environment Variables

# LLM Provider Configuration: "anthropic" | "openai" | "gemini" | "ollama"
SACCADE_LLM_PROVIDER=anthropic

# API Keys (BYOK - fill whichever provider you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Ollama Configuration (for private offline use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# LaTeX Compilation
# Set custom path to tectonic if not in system PATH
TECTONIC_PATH=

# Storage Directory for Local Profiles
SACCADE_DATA_DIR=~/.saccade
